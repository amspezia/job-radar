# Job Radar — configuration contract.
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is
# the committed source of truth for what the system needs. No real secrets here.

# --- Database (Postgres + pgvector) ---
DATABASE_URL=postgresql+psycopg://job_radar:job_radar@localhost:5432/job_radar
# A SEPARATE database, on the same server, that the embedding-eval harness owns: it
# creates, migrates and truncates this one. Production is only ever *read*, through a
# read-only connection. Must not name the DATABASE_URL database.
EVALS_DATABASE_URL=postgresql+psycopg://job_radar:job_radar@localhost:5432/job_radar_evals

# --- LLM provider selection ---
LLM_PROVIDER=ollama  # only "ollama" is implemented today

# --- Local models via Ollama (zero-cost dev path) ---
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
GENERATION_MODEL=qwen2.5
EXTRACTION_MODEL=  # optional; uses GENERATION_MODEL when unset — set a smaller model (e.g. qwen2.5:3b) for faster ingest
FIT_MODEL=  # optional; uses GENERATION_MODEL when unset — a smaller model is faster, not better; measure fit agreement first

# --- Paid LLM API (final quality pass; leave key empty for local-only dev) ---
# Read into Settings but not wired to a real provider yet — Phase E adds a
# second LLMProvider that uses these; LLM_PROVIDER stays "ollama" until then.
LLM_API_KEY=
LLM_API_MODEL=gpt-4o-mini

# --- Observability (Langfuse, natively OTel-based since SDK v3+) ---
# Langfuse Cloud, not self-hosted — self-hosting needs Postgres + ClickHouse +
# Redis + S3-compatible storage, disproportionate for a single-user workload
# (see docs/plans/PHASE_C_OBSERVABILITY_DESIGN.md §2.3). Region endpoint
# depends on which Langfuse Cloud project you created:
# https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US).
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_ME
LANGFUSE_SECRET_KEY=sk-lf-REPLACE_ME
LANGFUSE_HOST=https://us.cloud.langfuse.com
# Off by default — traces never carry raw prompt/response text unless this is
# explicitly set. See config.py's langfuse_capture_full_payload docstring.
LANGFUSE_CAPTURE_FULL_PAYLOAD=false
# Not required — the Langfuse SDK exports directly, no local OTel Collector
# needed for a single-app setup. Only relevant if you add a second consumer
# of these traces later (see design doc §2.2).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Standard OTel env var — read by the SDK's default resource detection, not by
# job-radar code. Without it, traces show resourceAttributes.service.name as
# "unknown_service" in the Langfuse UI.
OTEL_SERVICE_NAME=job-radar

# --- App ---
LOG_LEVEL=INFO
